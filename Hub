--===============================================================
--  STEALTH
--===============================================================
local baseline = {}
for _, v in ipairs(CoreGui:GetChildren()) do baseline[v] = true end

local function esOculto(inst)
    if not C.stealth or not inst then return false end
    if baseline[inst] then return false end
    local p = inst
    while p and p ~= CoreGui do
        if baseline[p] then return false end
        p = p.Parent
    end
    return true
end

--===============================================================
--  BYPASS
--===============================================================
local H = { old = {} }

if hookmetamethod and newcclosure then
    H.old.namecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
        local m = getnamecallmethod()
        local safe = ours()

        if self == CoreGui and not safe and C.stealth then
            if m == "GetChildren" or m == "GetDescendants" then
                local list = H.old.namecall(self, ...)
                local out = {}
                for _, v in ipairs(list) do if not esOculto(v) then out[#out + 1] = v end end
                return out
            end
            if m == "FindFirstChild" or m == "WaitForChild" then
                local nm = ...
                local real = H.old.namecall(self, ...)
                if real and esOculto(real) then
                    if m == "FindFirstChild" then return nil end
                    for _, v in ipairs(CoreGui:GetChildren()) do
                        if v.Name == nm and not esOculto(v) then return v end
                    end
                    return nil
                end
                return real
            end
        end

        if m == "Kick" and self == LP then
            C.kickLog = tostring((...))
            warn("[Venice] Kick detectado: " .. C.kickLog)
            pcall(function()
                Rayfield:Notify({ Title = "Kick bloqueado", Content = C.kickLog, Duration = 6 })
            end)
            if C.blockKick then
                task.spawn(function()
                    task.wait(2.5)
                    if not LP.Parent and C.rejoin then
                        pcall(function() TS:TeleportToPlaceInstance(game.PlaceId, game.JobId, LP) end)
                    end
                end)
                return
            end
        end

        if m == "FireServer" and AIM.pos and C.silent and not safe then
            local args = table.pack(...)
            local t = typeof(args[1])
            if t == "CFrame" then
                local d = (args[1].Position - AIM.pos).Magnitude
                if d > 0.05 and d < C.silentRange then
                    args[1] = CFrame.new(AIM.pos) * (args[1] - args[1].Position)
                    return H.old.namecall(self, table.unpack(args, 1, args.n))
                end
            elseif t == "Vector3" then
                local d = (args[1] - AIM.pos).Magnitude
                if d > 0.05 and d < C.silentRange then
                    args[1] = AIM.pos
                    return H.old.namecall(self, table.unpack(args, 1, args.n))
                end
            end
        end

        return H.old.namecall(self, ...)
    end))

    H.old.index = hookmetamethod(game, "__index", newcclosure(function(self, k)
        if AIM.pos and C.silent and not ours() and self == Mouse then
            if k == "Hit" then return CFrame.new(AIM.pos) end
            if k == "Target" then return AIM.ch end
        end
        return H.old.index(self, k)
    end))

    H.old.newindex = hookmetamethod(game, "__newindex", newcclosure(function(self, k, v)
        if C.spoofSpeed and not ours() and typeof(self) == "Instance" and self:IsA("Humanoid") then
            if k == "WalkSpeed" and typeof(v) == "number" and v < C.walk - 2 then return end
            if k == "JumpPower" and typeof(v) == "number" and v < C.jump - 2 then return end
        end
        return H.old.newindex(self, k, v)
    end))
end

