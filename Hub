--===============================================================
--  UNLOAD
--===============================================================
local function Unload()
    for _, c in ipairs(Conn) do pcall(function() c:Disconnect() end) end
    pcall(function() task.cancel(shootThread) end)
    if H.old.namecall then pcall(function() hookmetamethod(game, "__namecall", H.old.namecall) end) end
    if H.old.index then pcall(function() hookmetamethod(game, "__index", H.old.index) end) end
    if H.old.newindex then pcall(function() hookmetamethod(game, "__newindex", H.old.newindex) end) end
    clearEsp() setHitbox(false)
    if circle then circle:Remove() end
    pcall(function() Window:Destroy() end)
    getgenv().VH = nil
end

getgenv().VH = { Unload = Unload }
