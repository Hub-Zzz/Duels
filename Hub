table.insert(Conn, Run.RenderStepped:Connect(function()
    if Cam ~= WS.CurrentCamera then Cam = WS.CurrentCamera end
    local t = (C.aim or C.autoShoot or C.silent) and getTarget() or nil
    AIM.pos, AIM.ch = t and t.pos or nil, t and t.ch or nil

    if circle then
        circle.Visible = (C.aim or C.autoShoot) and not C.silent
        circle.Position = mid()
        circle.Radius = C.fov
    end

    if t and C.aim then
        Cam.CFrame = Cam.CFrame:Lerp(CFrame.lookAt(Cam.CFrame.Position, t.pos), C.smooth)
    end

    if C.esp and C.espDist then
        for plr, o in pairs(EspTags) do
            local a = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
            local b = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
            if o.label then
                o.label.Text = (a and b) and (plr.Name .. "  [" .. math.floor((a.Position - b.Position).Magnitude) .. "m]") or plr.Name
            end
        end
    end
end))

local shootThread = task.spawn(function()
    while true do
        task.wait(0.02)
        if C.autoShoot and AIM.pos and os.clock() - lastShot >= C.fireRate then
            lastShot = os.clock()
            task.spawn(fire)
        end
    end
end)

table.insert(Conn, Run.Heartbeat:Connect(function()
    local ch = LP.Character
    local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    if hrp.Position.Y > -10 then LastSafe = hrp.CFrame end
    if C.antiVoid and hrp.Position.Y < -60 and LastSafe then ch:PivotTo(LastSafe) end
end))

table.insert(Conn, LP.Idled:Connect(function()
    if C.antiAfk then VU:CaptureController() VU:ClickButton2(Vector2.new()) end
end))

Players.PlayerAdded:Connect(function(p) if C.esp then task.wait(1) buildEsp(p) end end)
Players.PlayerRemoving:Connect(function(p)
    local o = EspTags[p]
    if o then if o.hl then o.hl:Destroy() end if o.bb then o.bb:Destroy() end EspTags[p] = nil end
end)

