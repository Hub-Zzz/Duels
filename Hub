--===============================================================
--  TARGETING
--===============================================================
local function getTarget()
    local best, bestD = nil, C.fov
    local c, origin = mid(), Cam.CFrame.Position
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP then
            local ch = plr.Character
            local hum = ch and ch:FindFirstChildOfClass("Humanoid")
            local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
            if hum and hrp and hum.Health > 0 then
                local aimPos = hrp.Position + hrp.AssemblyLinearVelocity * C.pred
                local sp, on = Cam:WorldToViewportPoint(aimPos)
                if on and sp.Z > 0 then
                    local d = (Vector2.new(sp.X, sp.Y) - c).Magnitude
                    if d <= bestD then
                        local clear = true
                        if C.wallCheck then
                            local rp = RaycastParams.new()
                            rp.FilterType = Enum.RaycastFilterType.Exclude
                            rp.FilterDescendantsInstances = { ch, LP.Character, Cam }
                            local hit = WS:Raycast(origin, aimPos - origin, rp)
                            if hit and not hit.Instance:IsDescendantOf(ch) then clear = false end
                        end
                        if clear then
                            bestD = d
                            best = { ch = ch, pos = aimPos }
                        end
                    end
                end
            end
        end
    end
    return best
end

--===============================================================
--  ESP / HITBOX
--===============================================================
local function clearEsp()
    for _, o in pairs(EspTags) do
        if o.hl then o.hl:Destroy() end
        if o.bb then o.bb:Destroy() end
    end
    EspTags = {}
end

local function buildEsp(plr)
    local ch = plr.Character
    if not ch or EspTags[plr] then return end
    local hl = Instance.new("Highlight")
    hl.FillColor = Color3.fromRGB(0, 170, 255)
    hl.FillTransparency = 0.55
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Adornee = ch
    hl.Parent = CoreGui
    local head = ch:FindFirstChild("Head")
    local bb
    if head then
        bb = Instance.new("BillboardGui")
        bb.Size = UDim2.fromOffset(170, 28)
        bb.StudsOffset = Vector3.new(0, 2.4, 0)
        bb.AlwaysOnTop = true
        bb.Adornee = head
        bb.Parent = CoreGui
        local t = Instance.new("TextLabel")
        t.Size = UDim2.fromScale(1, 1)
        t.BackgroundTransparency = 1
        t.Font = Enum.Font.GothamBold
        t.TextSize = 13
        t.TextColor3 = Color3.fromRGB(0, 190, 255)
        t.Text = plr.Name
        t.Parent = bb
    end
    EspTags[plr] = { hl = hl, bb = bb, label = bb and bb:FindFirstChildOfClass("TextLabel") }
end

local function refreshEsp()
    clearEsp()
    if C.esp then for _, p in ipairs(Players:GetPlayers()) do if p ~= LP then buildEsp(p) end end end
end

local function setHitbox(on)
    for _, plr in ipairs(Players:GetPlayers()) do
        local ch = plr.Character
        if ch then
            for _, n in ipairs({ "HumanoidRootPart", "Torso", "UpperTorso" }) do
                local p = ch:FindFirstChild(n)
                if p and p:IsA("BasePart") then
                    if on then
                        SavedSize[p] = p.Size
                        p.Size = p.Size * C.hitboxSize
                        p.CanCollide = false
                    elseif SavedSize[p] then
                        p.Size = SavedSize[p]
                        SavedSize[p] = nil
                    end
                end
            end
        end
    end
end

